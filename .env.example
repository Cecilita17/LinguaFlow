# Groq API Configuration (Backend only - Keep GROQ_API_KEY secure in server environment)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Authentication (Frontend - Vite)
# Create a Web Client ID in Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript origins: http://localhost:5173, https://your-domain.com
VITE_GOOGLE_CLIENT_ID=
