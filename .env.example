# ==============================================================================
# LINGUAFLOW CONFIGURATION GUIDE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER / BACKEND CONFIGURATION (Secret Server Environment Only)
# ------------------------------------------------------------------------------
# Port for the Node/Express backend (Default: 3001)
PORT=3001

# Groq Cloud API Key for AI conversation, grammar engine, whisper transcription
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: Multimodal vision model for Image Reader (Default: qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Vercel Blob Read/Write Token for Direct Audio Uploads up to 25 MB
# Automatically populated when creating a Blob Store in Vercel Storage Dashboard
BLOB_READ_WRITE_TOKEN=


# Cartesia API Key for Economic Live Voice Calls (Sonic TTS)
CARTESIA_API_KEY=

# Optional: Cartesia TTS model (Default: sonic-3.6, also supports sonic-multilingual)
CARTESIA_MODEL=sonic-3.6

# Optional: Override default Cartesia voice ID (UUID)
CARTESIA_VOICE_ID=

# Secret key used by the backend to sign and verify session JWTs (Cryptographic)
# In production, generate a secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=linguaflow-super-secret-session-key-2026

# Google OAuth Client ID for Backend Token Verification
# Must match the Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. CLIENT / FRONTEND CONFIGURATION (Vite Public Configuration)
# ------------------------------------------------------------------------------
# Public Google OAuth Web Client ID for Google Identity Services popup
# Authorized JavaScript Origins in Google Cloud Console:
#   - Development: http://localhost:5173, http://localhost:3001
#   - Production:  https://your-domain.com, https://your-render-url.onrender.com
# Authorized Redirect URIs:
#   - Development: http://localhost:5173
#   - Production:  https://your-domain.com
# Google Cloud Console APIs & Scopes required for Google Drive Backup:
#   1. Enable "Google Drive API" in Google Cloud Console (APIs & Services -> Enabled APIs & Services).
#   2. In OAuth consent screen, add scope:
#      - https://www.googleapis.com/auth/drive.file (Allows LinguaFlow to create and manage its own backup files)
VITE_GOOGLE_CLIENT_ID=

# Optional: Custom backend API base URL if frontend and backend are hosted on separate domains
# Leave blank when using Vite proxy in development or same-origin deployment
VITE_API_BASE_URL=
